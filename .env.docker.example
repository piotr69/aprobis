# Copy to .env.docker. Always pass --env-file .env.docker to Compose.
COMPOSE_PROJECT_NAME=aprobis

# Read https://go.microsoft.com/fwlink/?LinkId=746388 before accepting.
# Set to Y to accept the SQL Server license; Express is selected in Compose.
ACCEPT_EULA=

# Local demo defaults. For HTTPS behind a host proxy set the public URL and COOKIE_SECURE=true.
PUBLIC_URL=http://localhost:3000
WEB_PORT=3000
COOKIE_SECURE=false
# Local demo for one user only: do not trust browser-supplied forwarding headers.
# All clients share the web container IP in API rate limits/audit in this mode.
# With the documented host Caddy proxy: 1 (Caddy replaces X-Forwarded-For; Next preserves it).
TRUST_PROXY_HOPS=0

# Run: node scripts/create-docker-secrets.mjs
SQL_SA_PASSWORD_FILE=./.secrets/sql-sa-password
SQL_APP_PASSWORD_FILE=./.secrets/sql-app-password
ADMIN_PASSWORD_FILE=./.secrets/admin-password

# Used only by the one-shot migrate service on a fresh database.
ADMIN_EMAIL=
ADMIN_LOGIN=admin
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# clamav recommended. disabled deliberately allows files without scanning.
# Changing this requires recreating BOTH api and worker; never use defender in Linux containers.
AV_SCANNER=clamav
