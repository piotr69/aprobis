# Skopiuj do .env i uzupełnij wartości. Plik .env jest ignorowany przez git.
NODE_ENV="development"

# Połączenie do MSSQL. Na Windows najprościej przez konto systemowe:
DATABASE_URL="sqlserver://127.0.0.1:1433;database=Aprobis;integratedSecurity=true;trustServerCertificate=true"
# Albo loginem SQL. W produkcji konto o ograniczonych uprawnieniach (NIE 'sa')
# i prawidłowy certyfikat TLS zamiast trustServerCertificate=true:
# DATABASE_URL="sqlserver://127.0.0.1:1433;database=Aprobis;user=aprobis_app;password=ZMIEN;trustServerCertificate=true"

# Tylko dla `npm run test:integration`: osobna baza, którą testy czyszczą. Musi nazywać się dokładnie AprobisTest.
# TEST_DATABASE_URL="sqlserver://127.0.0.1:1433;database=AprobisTest;integratedSecurity=true;trustServerCertificate=true"

PORT=4000
FRONTEND_URL="http://localhost:3000"

# Liczba zaufanych proxy przed aplikacją (0 = brak, 1 = pojedynczy nginx/IIS).
# Musi być ustawione poprawnie na produkcji, inaczej req.ip zwraca adres proxy
# i limit prób logowania obejmie wszystkich użytkowników łącznie.
TRUST_PROXY_HOPS=0

# Cookie sesji tylko przez HTTPS: domyślnie tak na produkcji. "false" dla instalacji po HTTP.
# COOKIE_SECURE="false"

# Katalog załączników, względem rootu repozytorium.
FILE_STORAGE_PATH="./backend/storage"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Skaner załączników:
#   defender — Windows Defender (MpCmdRun.exe); domyślny na Windows,
#   clamav   — demon clamd po TCP (Linux, Docker); StreamMaxLength w clamd.conf co najmniej 26M (limit uploadu to 25 MiB),
#   disabled — świadomie bez skanowania: pliki oznaczone „Nie skanowano” są dostępne od razu.
# Bez wartości poza Windows skaner jest nieskonfigurowany i załączniki czekają w stanie „Skanowanie…”.
# AV_SCANNER="defender"
# Niestandardowa lokalizacja MpCmdRun.exe.
# AV_SCANNER_PATH=""
# CLAMAV_HOST="127.0.0.1"
# CLAMAV_PORT=3310

# Poczta do powiadomień i linków z nowym hasłem. Bez SMTP_HOST lokalnie link trafia do logu serwera.
# Te same ustawienia można też wpisać w programie: Administracja → Konfiguracja.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=465
# SMTP_SECURE="true"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="Aprobis <aprobis@example.com>"
